<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <header class="site-header">
        <a class="site-brand" href="/" aria-label="CSE 340 Service Network home">
            <span class="brand-mark" aria-hidden="true">SN</span>
            <span class="brand-name"><span>CSE 340</span><strong>Service Network</strong></span>
        </a>
        <nav aria-label="Main navigation">
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/organizations">Organizations</a></li>
                <li><a href="/projects">Projects</a></li>
                <li><a href="/categories">Categories</a></li>
                <% if (isLoggedIn) { %>
                    <li><a href="/logout">Logout</a></li>
                <% } else { %>
                    <li><a href="/register">Register</a></li>
                    <li><a href="/login">Login</a></li>
                <% } %>
            </ul>
        </nav>
    </header>

    <% const messages = typeof flash === 'function' ? flash() : { success: [], error: [], warning: [], info: [] }; %>
    <% Object.keys(messages).forEach(type => { %>
        <% if (messages[type] && messages[type].length > 0) { %>
            <% messages[type].forEach(msg => { %>
                <%= msg %>
            <% }); %>
        <% } %>
    <% }); %>