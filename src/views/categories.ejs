<%- include('partials/header') %>
    <main id="main-content" class="categories-page">
        <h1><%= title %></h1>
        <p>Categories of service projects:</p>
        <p><a href="/new-category">Add a new category</a></p>
        <ul>
            <% categories.forEach(category => { %>
                <li>
                    <a href="/category/<%= category.category_id %>"><%= category.name %></a>
                    <a href="/edit-category/<%= category.category_id %>">Edit</a>
                </li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>