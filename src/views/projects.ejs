<%- include('partials/header') %>
    <main id="main-content" class="projects-page">
        <h1><%= title %></h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% projects.forEach(project => { %>
                <li><%= project.formatted_date %>: <%= project.title %> (<%= project.organization_name %>)</li>
            <% }); %>
        </ul>
    </main>
<%- include('partials/footer') %>