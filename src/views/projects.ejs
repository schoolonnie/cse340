<%- include('partials/header') %>
    <main id="main-content" class="projects-page">
        <h1><%= title %></h1>
        <h2>Upcoming Service Projects</h2>
        <ul>
            <% upcomingProjects.forEach(project => { %>
                <li>
                    <h3>
                        <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    </h3>
                    <p><%= project.description %></p>
                    <p>Date: <%= project.date %></p>
                    <p>Location: <%= project.location %></p>
                    <p>Organization: <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>
                </li>
            <% }); %>
        </ul>
        <p><a href="/new-project">Add a New Service Project</a></p>
    </main>
<%- include('partials/footer') %>