<%- include('partials/header') %>
<main>
    <h1><%= title %></h1>

    <% if (typeof errors !== 'undefined' && errors.length) { %>
        <div class="error-list">
            <% errors.forEach(error => { %>
                <p><%= error.msg %></p>
            <% }); %>
        </div>
    <% } %>

    <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">
        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="title"
                name="title"
                maxlength="150"
                required
                value="<%= projectDetails.title %>"
            />
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                maxlength="1000"
                required
            ><%= projectDetails.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                maxlength="200"
                required
                value="<%= projectDetails.location %>"
            />
        </div>

        <div class="form-group">
            <label for="date">Date</label>
            <input
                type="date"
                id="date"
                name="date"
                required
                value="<%= projectDetails.date ? new Date(projectDetails.date).toISOString().split('T')[0] : '' %>"
            />
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>
            <select id="organizationId" name="organizationId" required>
                <option value="">Select an organization</option>
                <% organizations.forEach(org => { %>
                    <option value="<%= org.organization_id %>" <%= org.organization_id === projectDetails.organization_id ? 'selected' : '' %>>
                        <%= org.name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <div class="form-group">
            <label>Categories</label>
            <div class="checkbox-group">
                <% categories.forEach(category => { %>
                    <% const isChecked = selectedCategories.some(selected => selected.category_id === category.category_id); %>
                    <label class="checkbox-item">
                        <input
                            type="checkbox"
                            name="categoryId"
                            value="<%= category.category_id %>"
                            <%= isChecked ? 'checked' : '' %>
                        />
                        <span><%= category.name %></span>
                    </label>
                <% }); %>
            </div>
        </div>

        <button type="submit">Update Project</button>
    </form>
</main>
<%- include('partials/footer') %>
